# ============================================================================
#  observerX_ai — configuration
#  Copy this file to ".env" and adjust as needed:  cp .env.example .env
# ============================================================================

# --- Model selection (downloaded from Hugging Face) -------------------------
MODEL_HF_REPO=0bserverx/Qwen3.8-27B-Heretic-Abliterated-Uncensored-GGUF
# The main weights file. Pick a smaller quant if you have less RAM/VRAM:
#   RVN-Q4_K_M.gguf  (~16 GB, recommended default)
#   RVN-Q3_K_M.gguf  (~13 GB)
#   RVN-IQ2_M.gguf   (~10 GB, low quality but light)
MODEL_HF_FILE=RVN-Q4_K_M.gguf
# Vision projector — enables image understanding. Leave as-is.
MMPROJ_HF_FILE=mmproj-Qwen3.8-27B-Q8_0.gguf
# Optional Hugging Face token for gated/rate-limited downloads (usually blank).
HF_TOKEN=

# --- llama.cpp runtime ------------------------------------------------------
# Context window in tokens (the model supports up to 262144).
LLAMA_CTX=8192
# Number of layers offloaded to GPU. 0 = CPU only.
# Set to 99 to offload everything to GPU (requires the CUDA image, see README).
LLAMA_NGL=0
# CPU threads. 0 = auto-detect.
LLAMA_THREADS=0
# Turn image understanding on/off.
ENABLE_VISION=true

# --- Backend gateway --------------------------------------------------------
# Whisper speech-to-text model: tiny | base | small | medium | large-v3
WHISPER_MODEL=base
WHISPER_ENABLED=true
# Reject uploads larger than this (per file), in megabytes.
MAX_UPLOAD_MB=50
# Friendly name shown in the UI header.
MODEL_DISPLAY_NAME=Qwen3.8-27B Heretic (Abliterated, Uncensored)
# Optional system prompt sent with every conversation.
SYSTEM_PROMPT=You are a helpful, knowledgeable assistant. Answer clearly and concisely in English.

# --- Web ---------------------------------------------------------------------
# Host port the web UI is served on:  http://localhost:${WEB_PORT}
WEB_PORT=3000
